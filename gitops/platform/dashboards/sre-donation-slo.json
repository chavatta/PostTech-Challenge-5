{
 "uid": "sre-donation-slo",
 "title": "SRE — donation-service SLOs & Error Budget",
 "tags": [
  "sre",
  "slo",
  "solidarytech"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "SLOs (janela 30 dias)",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "SLI Disponibilidade (30d) — SLO 99.9%",
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sli:donation_availability:ratio_rate30d",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 4,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 0.999
       }
      ]
     }
    }
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Error Budget restante — disponibilidade",
   "gridPos": {
    "x": 6,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "slo:donation_availability:error_budget_remaining",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.2
       },
       {
        "color": "green",
        "value": 0.5
       }
      ]
     }
    }
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "SLI Latência < 250ms (30d) — SLO 99%",
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sli:donation_latency_good:ratio_rate30d",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 3,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 0.99
       }
      ]
     }
    }
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Error Budget restante — latência",
   "gridPos": {
    "x": 18,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "slo:donation_latency:error_budget_remaining",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.2
       },
       {
        "color": "green",
        "value": 0.5
       }
      ]
     }
    }
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 6,
   "type": "row",
   "title": "Golden Metrics",
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 24,
    "h": 1
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Tráfego (req/s) por status",
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum by (status) (rate(http_requests_total{namespace=\"solidarytech\",container=\"donation-service\"}[5m]))",
     "legendFormat": "{{status}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    }
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Latência p50 / p95 / p99",
   "gridPos": {
    "x": 12,
    "y": 6,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"solidarytech\",container=\"donation-service\"}[5m])))",
     "legendFormat": "p50",
     "refId": "A"
    },
    {
     "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"solidarytech\",container=\"donation-service\"}[5m])))",
     "legendFormat": "p95",
     "refId": "B"
    },
    {
     "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"solidarytech\",container=\"donation-service\"}[5m])))",
     "legendFormat": "p99",
     "refId": "C"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    }
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Taxa de erro (5xx) — 5m vs 1h",
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "1 - sli:donation_availability:ratio_rate5m",
     "legendFormat": "erro 5m",
     "refId": "A"
    },
    {
     "expr": "1 - sli:donation_availability:ratio_rate1h",
     "legendFormat": "erro 1h",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "thresholdsStyle": {
       "mode": "line"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 0.001
       }
      ]
     }
    }
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Saturação: CPU e memória vs requests",
   "gridPos": {
    "x": 12,
    "y": 14,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"solidarytech\",container=\"donation-service\"}[5m])) / sum(kube_pod_container_resource_requests{namespace=\"solidarytech\",container=\"donation-service\",resource=\"cpu\"})",
     "legendFormat": "cpu / request",
     "refId": "A"
    },
    {
     "expr": "sum(container_memory_working_set_bytes{namespace=\"solidarytech\",container=\"donation-service\"}) / sum(kube_pod_container_resource_requests{namespace=\"solidarytech\",container=\"donation-service\",resource=\"memory\"})",
     "legendFormat": "mem / request",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    }
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 11,
   "type": "row",
   "title": "Burn rate (alertas multi-janela)",
   "gridPos": {
    "x": 0,
    "y": 22,
    "w": 24,
    "h": 1
   }
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Burn rate disponibilidade (1 = consome o budget exatamente em 30d)",
   "gridPos": {
    "x": 0,
    "y": 23,
    "w": 24,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "(1 - sli:donation_availability:ratio_rate5m) / 0.001",
     "legendFormat": "5m",
     "refId": "A"
    },
    {
     "expr": "(1 - sli:donation_availability:ratio_rate1h) / 0.001",
     "legendFormat": "1h",
     "refId": "B"
    },
    {
     "expr": "(1 - sli:donation_availability:ratio_rate6h) / 0.001",
     "legendFormat": "6h",
     "refId": "C"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 6
       },
       {
        "color": "red",
        "value": 14.4
       }
      ]
     },
     "custom": {
      "thresholdsStyle": {
       "mode": "line"
      }
     }
    }
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Réplicas (HPA) e pods prontos",
   "gridPos": {
    "x": 0,
    "y": 31,
    "w": 24,
    "h": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "kube_deployment_status_replicas_available{namespace=\"solidarytech\",deployment=\"donation-service\"}",
     "legendFormat": "disponíveis",
     "refId": "A"
    },
    {
     "expr": "kube_horizontalpodautoscaler_status_desired_replicas{namespace=\"solidarytech\",horizontalpodautoscaler=\"donation-service\"}",
     "legendFormat": "desejadas (HPA)",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    }
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  }
 ]
}